{
  "name": "@samthesomebody/kit",
  "version": "0.3.0",
  "description": "Tool chrome layout recipes + Svelte controls + optional terminal panes. Optional shell: @samthesomebody/dock (separate package).",
  "type": "module",
  "svelte": "./index.ts",
  "bin": {
    "kit-check": "./check/cli.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamTheSomebody/kit.git",
    "directory": "kit"
  },
  "exports": {
    ".": {
      "svelte": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json",
    "./layout.css": "./layout.css",
    "./tokens.css": "./tokens.css",
    "./vars.css": "./vars.css",
    "./base.css": "./base.css",
    "./column.svelte": "./column.svelte",
    "./columns.svelte": "./columns.svelte",
    "./row.svelte": "./row.svelte",
    "./container.svelte": "./container.svelte",
    "./slot.svelte": "./slot.svelte",
    "./components": {
      "svelte": "./components/index.ts",
      "default": "./components/index.ts"
    },
    "./components/index.css": "./components/index.css",
    "./components/*.css": "./components/*.css",
    "./components/*.svelte": "./components/*.svelte",
    "./components/*.ts": "./components/*.ts",
    "./terminal": "./terminal/index.ts",
    "./terminal/*.css": "./terminal/*.css",
    "./terminal/*.ts": "./terminal/*.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "files": [
    "*.ts",
    "*.svelte",
    "*.css",
    "*.json",
    "components",
    "fonts",
    "terminal",
    "README.md",
    "check/*.js",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "layout",
    "svelte",
    "tooling",
    "chrome",
    "ui-kit",
    "terminal",
    "xterm"
  ]
}
